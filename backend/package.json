{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-commerce backend API implementing Docker best practices",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "mkdir -p dist && cp src/server.js dist/",
    "test": "jest --coverage",
    "docker:build": "docker build -t ecommerce-backend .",
    "docker:build-prod": "docker build -f Dockerfile.prod -t ecommerce-backend:prod ."
  },
  "keywords": ["docker", "best-practices", "nodejs", "express"],
  "author": "MartinS984",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}